import java.util.Scanner;
class Example 
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("enter m:-");
		int m=sc.nextInt();
		System.out.println("enter n:-");
		int n=sc.nextInt();
		int product=1;
		for (int i=m;i<=n ;i++ )
		{
			product*=i;
			
		}
		System.out.println(product);

	}
}
