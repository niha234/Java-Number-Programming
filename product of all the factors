import java.util.Scanner;
class Example 
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("enter number :-");
		int num=sc.nextInt();
		int product=1;


		for (int i=1;i<=num ;i++ )
		{
			if (num%i==0 )
				product*=i;
		}
		System.out.println("product of factors of "+ num+ " = "+product);

		
	}
}
