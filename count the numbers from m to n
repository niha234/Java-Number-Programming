import java.util.Scanner;
class Example 
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("enter m:-");
		int m=sc.nextInt();
		System.out.println("enter n:-");
		int n=sc.nextInt();
		int count=0;
		for (int i=m;i<=n ;i++ )
		{
			count++;	
		}
		System.out.println(count);

	}
}
